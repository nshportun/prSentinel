{
  "name": "pr-sentinel",
  "version": "0.1.0",
  "description": "AI-powered GitHub Action for ML/data-quality checks in diffs",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node --input-type=module esbuild.config.mjs",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "github-action",
    "ml-ops",
    "data-quality",
    "pii-detection",
    "schema-validation"
  ],
  "author": "Your Name",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/sdk": "^0.34.0",
    "octokit": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitest/coverage-v8": "^1.0.4",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}
